# MedLock local runtime. Copy to .env and chmod 600.
# Never commit .env. run.sh loads this file without printing values.

# --- Paths ---
PROJECT_DIR=
MODEL_DIR=
MODEL_PATH=llm/qwen2.5-0.5b/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
EMBEDDING_MODEL_PATH=
LLAMACPP_DIR=
LLAMA_SERVER_BIN=
# Runtime data (chats, uploads, logs). Chosen at install via Browse.
MEDLOCK_DATA=
MEDLOCK_DATA_ROOT=
MEDLOCK_WORKSPACE=

# --- Bind / URLs (loopback only by default) ---
MEDLOCK_HOST=127.0.0.1
MEDLOCK_PORT=8000
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
CHAT_HOSTNAME=medlock.chat
ADMIN_HOSTNAME=medlock.admin
PUBLIC_BASE_URL=http://medlock.chat:8000
ADMIN_BASE_URL=http://medlock.admin:8000

# --- Inference (local only) ---
SERVED_MODEL_NAME=medlock-llm
EMBEDDING_MODEL_NAME=bge-small-en-v1.5
LLAMA_API_KEY=change-me
MEDLOCK_ADMIN_TOKEN=change-me
MEDLOCK_SESSION_SECRET=change-me
NEMOCLAW_LLAMACPP_LOCAL_TOKEN=
MMPROJ_PATH=
LLAMA_CTX=8192
LLAMA_N_GPU_LAYERS=99

# --- Database ---
# Postgres is preferred. If 5432 is refused, the app falls back to
# $MEDLOCK_DATA/data/medlock.sqlite (WAL mode).
DATABASE_URL=postgresql+psycopg://medlock:change-me@127.0.0.1:5432/medlock
POSTGRES_USER=medlock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medlock
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Optional ServiceNow (disabled unless explicitly enabled) ---
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_USERNAME=

# --- Demo / safety ---
MEDLOCK_DEMO=false
LOG_LEVEL=INFO
